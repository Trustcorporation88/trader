# Obrigatória: chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo do Trader. Padrão: claude-opus-5 (mais capaz).
# Para reduzir custo: claude-sonnet-5. O servidor confere no boot se o ID existe na conta.
CLAUDE_MODEL=claude-opus-5

# Opcional: profundidade de raciocínio (low, medium, high, xhigh, max). Padrão: high.
CLAUDE_EFFORT=high

# Opcional: orçamento máximo de uma resposta, streaming incluído (padrão: 300000 = 5 min)
TIMEOUT_IA_MS=

# Opcional: requisições por minuto por IP (padrão: 20)
RATE_LIMIT_POR_MINUTO=

# Opcional: senha única de acesso ao site. Sem ela, o site fica aberto.
SENHA_ACESSO=
