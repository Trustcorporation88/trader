# Obrigatória: chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo do Trader. Padrão: claude-opus-5 (mais capaz).
# Para reduzir custo: claude-sonnet-5. O servidor confere no boot se o ID existe na conta.
CLAUDE_MODEL=claude-opus-5

# Opcional: profundidade de raciocínio (low, medium, high, xhigh, max). Padrão: high.
CLAUDE_EFFORT=high

# Opcional: orçamento máximo de uma resposta, streaming incluído (padrão: 300000 = 5 min)
TIMEOUT_IA_MS=

# Opcional: requisições por minuto por IP (padrão: 20)
RATE_LIMIT_POR_MINUTO=

# Opcional: senha única de acesso ao site. Sem ela, o site fica aberto.
SENHA_ACESSO=

# Painel EUA. Sem estas chaves as rotas /api/eua/* respondem 503 e o resto do app funciona.
# Finnhub (cotações de ações e notícias dos EUA): finnhub.io/register
FINNHUB_API_KEY=
# FRED (indicadores macro dos EUA): fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Painel Brasil. Sem estas chaves as rotas /api/br/* respondem 503.
# brapi (cotações da B3): brapi.dev/dashboard
BRAPI_API_KEY=
# Exa (notícias por ativo): exa.ai — usada em /api/br/noticias?symbol=PETR4
EXA_API_KEY=
